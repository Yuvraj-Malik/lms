# Copy to .env (in this folder, next to client/ and server/) and fill in.
# The server and the Vite client both read this one file. Never commit .env.

# ── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Comma-separated list of front-end origins allowed to call the API
CLIENT_URL=http://localhost:5174
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lms
JWT_SECRET=<a long random string>
JWT_EXPIRES_IN=7d

# Optional: lets people register as instructors with this code. Leave empty to disable.
ADMIN_SIGNUP_CODE=

# Optional: email (password reset, announcements, new assignments, grades).
# Without these, emails are printed to the server console instead.
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Ridgeline <you@example.com>"

# Google sign-in: the server verifies Firebase ID tokens for this project.
# Defaults to VITE_FIREBASE_PROJECT_ID when not set.
FIREBASE_PROJECT_ID=

# ── Client (exposed to the browser, so only public Firebase config) ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
